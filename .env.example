# ═══════════════════════════════════════════════════════════════════════════════
# Variables de entorno — Pizarra Digital Envasado RP06 (Minalba)
# Copia este archivo como ".env" en local (NUNCA subir .env a GitHub).
# En Render, configura estas variables en: Dashboard -> Environment Variables.
# NOTA: Las contraseñas de usuarios NO van aquí; se guardan encriptadas (hash)
#       en la tabla "usuarios" de la base de datos mediante admin_usuarios.py
#       o el panel de Administración web.
# ═══════════════════════════════════════════════════════════════════════════════

# 1. Clave secreta de sesiones Flask (OBLIGATORIA en producción / Render)
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# 2. Base de datos PostgreSQL permanente (Neon.tech o Supabase) para Render:
# Ejemplo:
#   DATABASE_URL=postgresql://usuario:clave@ep-xxxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
# Si se deja vacía en tu PC, usará SQLite local (produccion.db).
DATABASE_URL=

# 3. Seguridad de sesión (en segundos, 7200 = 2 horas absolutas como Dashboard 4.0)
SESION_MAX_SEGUNDOS=7200

# 4. CORS restringido: lista separada por comas de orígenes externos permitidos.
# Déjalo vacío para restringir estrictamente al mismo dominio del servidor.
ORIGENES_PERMITIDOS=

# 5. Límites anti fuerza bruta (Dashboard 4.0)
LOGIN_MAX_FALLOS_IP=8
LOGIN_MAX_FALLOS_USUARIO=15
LOGIN_VENTANA_SEGUNDOS=300
API_MAX_POR_MIN_IP=3000
API_MAX_POR_MIN_USUARIO=3000
ESCRITURAS_MAX_POR_MIN_USUARIO=300
